# Optional. Everything has a safe default; Mock needs no tenant and no credentials.
# PORT must be 7800 (this app's one allocated port).
PORT=7800
# OBS_BIND=127.0.0.1   # loopback only unless you set this on purpose
# Real mode (owner-run): a Loki on THIS machine, loopback only, read-only.
# OBS_LOKI_URL=http://127.0.0.1:3100
# Own stack: OBS_LOKI_URL=http://127.0.0.1:3100 docker compose --profile stack up -d   (see README)
# Browser driver: DRIVE_LABS=a-lab,b-lab  DRIVE_ROUNDS=3  docker compose --profile drive run --rm driver
