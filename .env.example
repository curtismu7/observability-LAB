# Optional. Everything has a safe default; Mock needs no tenant and no credentials.
# PORT must be 7800 (this app's one allocated port).
PORT=7800
# OBS_BIND=127.0.0.1   # loopback only unless you set this on purpose
# Real mode (owner-run): a Loki on THIS machine, loopback only, read-only.
# OBS_LOKI_URL=http://127.0.0.1:3100
# Own stack: OBS_LOKI_URL=http://127.0.0.1:3100 docker compose --profile stack up -d   (see README)
# Browser driver: DRIVE_LABS=a-lab,b-lab  DRIVE_ROUNDS=3  docker compose --profile drive run --rm driver

# Privilege SIEM (Elasticsearch): a second Real source, read-only, loopback only. The OWNER creates a read key limited to the one index; this
# lab never creates a credential. Mock needs none of this. Run the lab on the host (npm start) to use it: from Docker, loopback is the container.
#   kubectl --context us -n ping-devops-curtismuir port-forward svc/elasticsearch-siem 9200:9200
# PRIVILEGE_SIEM_URL=http://127.0.0.1:9200
# PRIVILEGE_SIEM_INDEX=ping-siem-events-v2
# PRIVILEGE_SIEM_READ_APIKEY=
# PRIVILEGE_SIEM_TIME_FIELD=@timestamp
# The Kibana link on the Privilege sources (an anchor only; the lab never calls it). Default http://localhost:5601.
#   kubectl --context us -n ping-devops-curtismuir port-forward svc/kibana-siem 5601:5601
# PRIVILEGE_KIBANA_URL=http://localhost:5601
